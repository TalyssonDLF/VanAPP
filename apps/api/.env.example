# Comma-separated, explicit origins allowed to send credentialed requests.
FRONTEND_URLS=http://localhost:5173,https://vanapp-front.onrender.com

# Render provides PORT automatically. This value is only a local default.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/vanescolar
JWT_SECRET=replace-with-at-least-32-random-characters
